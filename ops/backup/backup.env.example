# Install as /etc/alright-mate/backup.env with owner root:alright-mate-backup and mode 0640.
# Values below are deliberately non-functional. Supply them from the production secret store.
AGE_RECIPIENT=age1replacewiththeproductionpublicrecipient
BACKUP_RETENTION_DAYS=30
DATABASE_URL=postgres://replace-via-secret-store
S3_ACCESS_KEY=replace-via-secret-store
S3_BUCKET=replace-with-tofu-backup-bucket-name
S3_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
S3_REGION=ap-northeast-2
S3_SECRET_KEY=replace-via-secret-store
