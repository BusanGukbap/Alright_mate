server {
    listen 8080 default_server;
    server_name _;
    return 444;
}

server {
    listen 8080;
    server_name ${SERVER_NAME};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://${SERVER_NAME}$request_uri;
    }
}

server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    return 444;
}

server {
    listen 8443 ssl;
    server_name ${SERVER_NAME};
    client_max_body_size 1m;
    send_timeout 30s;

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/security-headers.conf;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location = /healthz {
        proxy_set_header X-Alright-Mate-Owner "";
        include /etc/nginx/snippets/api-proxy-common.conf;
    }

    location = /readyz {
        proxy_set_header X-Alright-Mate-Owner "";
        include /etc/nginx/snippets/api-proxy-common.conf;
    }

    location ^~ /api/v1/expressions {
        proxy_set_header X-Alright-Mate-Owner "";
        include /etc/nginx/snippets/api-proxy-common.conf;
    }

    location ^~ /api/v1/admin/ {
        auth_request /oauth2/auth;
        auth_request_set $authenticated_owner $upstream_http_x_auth_request_user;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie always;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        proxy_set_header X-Alright-Mate-Owner $authenticated_owner;
        include /etc/nginx/snippets/api-proxy-common.conf;
    }

    location = /api/v1/admin {
        auth_request /oauth2/auth;
        auth_request_set $authenticated_owner $upstream_http_x_auth_request_user;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie always;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        proxy_set_header X-Alright-Mate-Owner $authenticated_owner;
        include /etc/nginx/snippets/api-proxy-common.conf;
    }

    location ^~ /api/ {
        proxy_set_header X-Alright-Mate-Owner "";
        include /etc/nginx/snippets/api-proxy-common.conf;
    }

    location = /metrics {
        return 404;
    }

    location = /oauth2/auth {
        internal;
        proxy_pass http://oauth2_proxy:4180/oauth2/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Forwarded-Uri $request_uri;
        include /etc/nginx/snippets/oauth2-proxy-common.conf;
    }

    location ^~ /oauth2/ {
        proxy_pass http://oauth2_proxy:4180;
        proxy_set_header X-Auth-Request-Redirect $request_uri;
        include /etc/nginx/snippets/oauth2-proxy-common.conf;
    }

    location = /expressions {
        include /etc/nginx/snippets/web-proxy-common.conf;
    }

    location ^~ /expressions/ {
        include /etc/nginx/snippets/web-proxy-common.conf;
    }

    location = /admin {
        auth_request /oauth2/auth;
        error_page 401 = @oauth2_signin;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie always;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        include /etc/nginx/snippets/web-proxy-common.conf;
    }

    location ^~ /admin/ {
        auth_request /oauth2/auth;
        error_page 401 = @oauth2_signin;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie always;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        include /etc/nginx/snippets/web-proxy-common.conf;
    }

    location = /review {
        auth_request /oauth2/auth;
        error_page 401 = @oauth2_review_signin;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie always;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        include /etc/nginx/snippets/web-proxy-common.conf;
    }

    location ^~ /review/ {
        auth_request /oauth2/auth;
        error_page 401 = @oauth2_review_signin;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie always;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        include /etc/nginx/snippets/web-proxy-common.conf;
    }

    location @oauth2_signin {
        return 302 /oauth2/start?rd=/admin;
    }

    location @oauth2_review_signin {
        return 302 /oauth2/start?rd=/review;
    }

    location / {
        include /etc/nginx/snippets/web-proxy-common.conf;
    }
}
