operator_ssh_access = {
  cidrs           = ["203.0.113.10/32"]
  ipv6_cidrs      = []
  allow_world_ssh = false
}

backup_bucket_name       = "replace-with-a-globally-unique-backup-bucket"
backup_retention_days    = 30
budget_notification_email = "operator@example.invalid"

# Set a registered domain only when Lightsail should manage its DNS zone.
domain_name      = null
dns_record_names = ["@", "www"]
